{
  "name": "copy-review-desk-apple",
  "version": "1.0.12",
  "private": true,
  "description": "A glass macOS menu bar workspace for copy review and project planning.",
  "type": "module",
  "main": "desktop/main.cjs",
  "author": "Gracylart",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-build.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "prepare:electron": "node node_modules/electron/install.js",
    "build:mac": "npm run prepare:pdf && npm run check && npm run icons && npm run prepare:electron && electron-builder --mac dir zip --arm64",
    "build:mac:dir": "npm run prepare:pdf && npm run check && npm run icons && npm run prepare:electron && electron-builder --mac dir --arm64",
    "prepare:pdf": "node scripts/prepare-pdf-font.mjs"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.gracylart.copyreviewdesk.apple",
    "productName": "文案审核台 · Apple",
    "artifactName": "Copy-Review-Desk-Apple-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "desktop/assets"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "!dist/**/*.map",
      "!dist/**/.DS_Store",
      "!desktop/assets/app.iconset/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "extraResources": [
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "licenses/Electron-LICENSE"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "licenses/Chromium-LICENSES.html"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "desktop/assets/app.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "LSUIElement": true,
        "NSHighResolutionCapable": true
      },
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299"
  }
}
